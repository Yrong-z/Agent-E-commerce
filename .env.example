# 本地配置；真实密钥只写入未跟踪的 .env
DATABASE_URL=postgresql://shopping:shopping_demo_local@127.0.0.1:5433/shopping
POSTGRES_USER=shopping
POSTGRES_PASSWORD=shopping_demo_local
POSTGRES_DB=shopping
POSTGRES_PORT=5433
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
# 本地 TEI 无鉴权；此 Key 仅为 SDK 非秘密占位值。云端可另填真实 Key。
EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
EMBEDDING_API_KEY=local-no-secret
EMBEDDING_MODEL=bge-large-zh-v1.5
# 指向已有模型目录（含权重、配置、分词器），只读挂载；不自动下载。
EMBEDDING_MODEL_DIR=
EMBEDDING_PORT=8082
# 实测维度后填写，未配置时不创建固定维度向量
EMBEDDING_DIMENSION=
APP_MODE=demo
DEMO_CUSTOMER_ID=demo-user

# 本地部署/开发模式由启动脚本在应用进程内设置 SERVE_FRONTEND，无需在本文件填写。
